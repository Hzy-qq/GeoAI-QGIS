LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-v4-flash

PLANNER_MODE=native_tool_calling
PLANNER_ALLOW_JSON_FALLBACK=1
LLM_TOOL_CALL_THINKING=disabled
USE_LLM_SUMMARY=1

QGIS_PROCESS_CMD=F:\QGIS\bin\qgis_process-qgis-ltr.bat
QGIS_TIMEOUT_SECONDS=300

CHROMA_PATH=outputs/chroma
CHROMA_COLLECTION=geoai_state5_knowledge
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_LOCAL_FILES_ONLY=auto
QUIET_EMBEDDING_LOGS=1
RERANK_ENABLED=1
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_STRICT=0
RETRIEVAL_TOP_K=20
RERANK_TOP_K=4

# Docker Compose reads these values from the same untracked .env file.
MYSQL_DATABASE=geoai_qgis
MYSQL_USER=geoai
MYSQL_PASSWORD=replace_with_app_password
MYSQL_ROOT_PASSWORD=replace_with_root_password
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://geoai:replace_with_app_password@127.0.0.1:3306/geoai_qgis?charset=utf8mb4
DB_AUTO_CREATE=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
WORKER_STALE_AFTER_SECONDS=1200
WORKER_PENDING_MAX_AGE_SECONDS=900
WORKER_HEARTBEAT_PATH=outputs/worker_heartbeat.json
WORKER_HEARTBEAT_SECONDS=2
WORKER_HEARTBEAT_TIMEOUT_SECONDS=10
TASK_PENDING_WORKER_GRACE_SECONDS=20

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=
READINESS_CHECK_CHROMA=1

OSM_USER_AGENT=GeoAI-QGIS-Final/1.0 (educational GIS agent)
DATA_HTTP_TIMEOUT_SECONDS=120
DATA_HTTP_RETRIES=2
DATA_HTTP_MAX_BACKOFF_SECONDS=8
DATA_HTTP_JITTER_MS=250
DATA_CIRCUIT_FAILURE_THRESHOLD=2
DATA_CIRCUIT_COOLDOWN_SECONDS=60
DATA_MAX_RESPONSE_BYTES=100000000
DATA_MAX_FILE_BYTES=250000000
DATA_FILE_TIMEOUT_SECONDS=300
DATA_MAX_QUERY_AREA_SQ_KM=15000
DATA_MAX_FEATURES=200000
DATA_CACHE_ENABLED=1
# The final project ships a Jiangsu OSM snapshot plus normalized Nanjing layers.
# auto = normalized offline pack -> local PBF -> bounded network fallback.
OSM_LOCAL_PBF_PATH=data/osm/jiangsu-latest.osm.pbf
BOUNDARY_SOURCE_MODE=auto
POI_SOURCE_MODE=auto
POI_TILE_DEGREES=0.5
POI_MAX_TILES=32
POI_TILE_WORKERS=4
POI_HTTP_TIMEOUT_SECONDS=20
POI_QUERY_TIMEOUT_SECONDS=25
POI_MAX_ENDPOINT_ATTEMPTS=1
POI_TILE_MIN_SUCCESS_RATIO=0.75
ROAD_SOURCE_MODE=auto
WATER_SOURCE_MODE=auto
OVERPASS_QUERY_TIMEOUT_SECONDS=120
OVERPASS_HTTP_TIMEOUT_SECONDS=60
OVERPASS_TILE_DEGREES=0.2
MAIN_ROAD_TILE_DEGREES=0.2
ROAD_SPLIT_RETRY_DEPTH=1
ROAD_MIN_SPLIT_DEGREES=0.005
ROAD_VECTOR_TILE_ZOOM=11
ROAD_VECTOR_TILE_MAX_TILES=120
ROAD_VECTOR_TILE_TIMEOUT_SECONDS=15
ROAD_VECTOR_TILE_WORKERS=2
OVERPASS_MAX_BATCHES=40
OVERPASS_BATCH_DELAY_SECONDS=0.5
ROAD_DOWNLOAD_DEADLINE_SECONDS=120
ROAD_HTTP_TIMEOUT_SECONDS=20
ROAD_MAX_ENDPOINT_ATTEMPTS=2

AGENT_MAX_PLAN_ATTEMPTS=2
AGENT_MAX_TOOL_CALLS=20
AGENT_DEADLINE_SECONDS=900
LANGGRAPH_RECURSION_LIMIT=20
LANGGRAPH_CHECKPOINT_PATH=outputs/checkpoints/state5.sqlite
CONVERSATION_RECENT_MESSAGES=6
CONVERSATION_SUMMARY_MAX_CHARS=2000
# Redis is an optional acceleration/reliability layer. MySQL and task files remain durable.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false
REDIS_EVENT_TTL_SECONDS=86400
