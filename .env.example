LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-v4-flash

# Optional. Override if your QGIS path is different.
QGIS_PROCESS_CMD=F:\QGIS\bin\qgis_process-qgis-ltr.bat

# Optional advanced RAG settings for Chroma + sentence-transformers.
CHROMA_PATH=outputs/chroma
CHROMA_COLLECTION=geoai_knowledge
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
