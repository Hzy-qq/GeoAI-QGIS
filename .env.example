LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-v4-flash

PLANNER_MODE=native_tool_calling
PLANNER_ALLOW_JSON_FALLBACK=1
LLM_TOOL_CALL_THINKING=disabled
USE_LLM_SUMMARY=1

QGIS_PROCESS_CMD=F:\QGIS\bin\qgis_process-qgis-ltr.bat
QGIS_TIMEOUT_SECONDS=300

CHROMA_PATH=outputs/chroma
CHROMA_COLLECTION=geoai_state3_knowledge
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_LOCAL_FILES_ONLY=auto
QUIET_EMBEDDING_LOGS=1

RERANK_ENABLED=1
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_STRICT=0
RETRIEVAL_TOP_K=20
RERANK_TOP_K=4

OSM_USER_AGENT=GeoAI-QGIS-State3/0.5 (educational GIS agent)
DATA_HTTP_TIMEOUT_SECONDS=120
DATA_HTTP_RETRIES=2
DATA_MAX_RESPONSE_BYTES=100000000
DATA_MAX_FILE_BYTES=250000000
DATA_FILE_TIMEOUT_SECONDS=300
DATA_MAX_QUERY_AREA_SQ_KM=15000
DATA_MAX_FEATURES=200000
DATA_CACHE_ENABLED=1
ROAD_SOURCE_MODE=auto
OVERPASS_QUERY_TIMEOUT_SECONDS=120
OVERPASS_HTTP_TIMEOUT_SECONDS=60
OVERPASS_TILE_DEGREES=0.2
OVERPASS_MAX_BATCHES=40
OVERPASS_BATCH_DELAY_SECONDS=0.5

AGENT_MAX_PLAN_ATTEMPTS=2
AGENT_MAX_TOOL_CALLS=20
AGENT_DEADLINE_SECONDS=900
LANGGRAPH_RECURSION_LIMIT=20
